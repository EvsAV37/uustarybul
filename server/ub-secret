#!/bin/bash
# Уустары бул — задать секрет для серверных функций (ключи Zvonok и т. п.). Запуск от root:
#   ub-secret ZVONOK_PUBLIC_KEY      — спросит значение (на экране не видно), сохранит, перезапустит функции
#   ub-secret --list                 — какие секреты заданы (только имена)
set -euo pipefail
F=/opt/supabase/functions.env
[ "$(id -u)" = 0 ] || { echo "Запустите от root: sudo ub-secret ..."; exit 1; }
touch "$F"; chmod 600 "$F"

if [ "${1:-}" = "--list" ] || [ -z "${1:-}" ]; then
  echo "Заданы:"; cut -d= -f1 "$F" | sed 's/^/  /'
  [ -z "${1:-}" ] && echo "Задать: ub-secret ИМЯ"
  exit 0
fi

name="$1"
[[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "Имя — большими латинскими буквами, например ZVONOK_PUBLIC_KEY"; exit 1; }
read -r -s -p "Значение $name (не отображается): " val; echo
[ -n "$val" ] || { echo "Пусто — ничего не меняю"; exit 1; }
[[ "$val" != *$'\n'* ]] || { echo "Значение должно быть в одну строку"; exit 1; }

grep -v "^${name}=" "$F" > "$F.tmp" || true
printf '%s=%s\n' "$name" "$val" >> "$F.tmp"
mv "$F.tmp" "$F"; chmod 600 "$F"
cd /opt/supabase && docker compose up -d --force-recreate functions >/dev/null 2>&1
echo "Готово: $name сохранён, функции перезапущены."
