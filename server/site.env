# Адреса сайта. Меняются здесь — deploy.sh сам обновит /opt/supabase/.env и перезапустит что нужно.
# SITE_DOMAIN — основной адрес (сайт + API + панель Supabase на :8443).
# REDIRECT_DOMAINS — адреса, которые перенаправляются на основной (через запятую).
SITE_DOMAIN=uustarybul.ru
REDIRECT_DOMAINS=www.uustarybul.ru, elva-technologies.fvds.ru
