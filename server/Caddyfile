# Уустары бул — Caddy: HTTPS (Let's Encrypt, сам продлевает), сайт и API на одном адресе.
# PROXY_DOMAIN — адрес сайта, REDIRECT_DOMAINS — адреса, перенаправляемые на него; панель Supabase — :8443 только через SSH-туннель.
# Всё задаётся в server/site.env. (перезапуск: 0121)

{$PROXY_DOMAIN} {
	encode zstd gzip

	# Превью ссылки на мастера (…/?m=<id>) для ботов соцсетей и мессенджеров — страница функции og (план, шаг 11).
	# Поисковики сюда не попадают: им, как и людям, отдаётся приложение.
	@ogbot {
		path /
		query m=*
		header_regexp User-Agent (?i)(vkShare|facebookexternalhit|facebookcatalog|WhatsApp|TelegramBot|OdklBot|Twitterbot|Slackbot|Discordbot|SkypeUriPreview|Viber|LinkedInBot|redditbot|Pinterest|Iframely|Embedly)
	}
	handle @ogbot {
		rewrite * /functions/v1/og?{query}
		reverse_proxy api-gw:8000
	}

	@api path /auth/v1/* /rest/v1/* /graphql/v1 /storage/v1/* /functions/v1/*
	handle @api {
		reverse_proxy api-gw:8000
	}

	handle {
		root * /srv/site
		@nocache path / /index.html /sw.js /manifest.webmanifest /admin/ /admin/index.html
		header @nocache Cache-Control "no-cache"
		# управление: не встраивать в чужие страницы, не индексировать
		header /admin* X-Frame-Options "DENY"
		header /admin* X-Robots-Tag "noindex, nofollow"
		file_server
	}

	header {
		-server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Панель Supabase (Studio) — из интернета закрыта: порт 8443 открыт только на 127.0.0.1 сервера (docker-compose.ub.yml).
# С ПК — через SSH-туннель: ssh -L 8443:127.0.0.1:8443 root@45.150.10.178, затем http://localhost:8443
# (HTTP внутри туннеля — соединение шифрует SSH). Плюс пароль. Журнал — для fail2ban; пароль Caddy в журнал не пишет.
http://:8443 {
	log {
		output file /var/log/caddy/studio.log {
			roll_size 5MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}
	basic_auth {
		{$PROXY_AUTH_USERNAME} {$PROXY_AUTH_PASSWORD}
	}
	reverse_proxy studio:3000
	header -server
}

# Другие адреса (www, технический адрес FirstVDS) — на основной
{$REDIRECT_DOMAINS} {
	redir https://{$PROXY_DOMAIN}{uri} permanent
}
